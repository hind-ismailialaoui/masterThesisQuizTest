PORT=3000

# AI provider: "openai" by default, or "ollama" if you want to use Ollama instead.
AI_PROVIDER=openai

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama configuration (used only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3.5:397b-cloud

# Optional: override the LSAT CSV knowledge base path
KB_CSV_PATH=

# Optional: Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
